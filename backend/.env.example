# Copy to backend/.env and fill in real values. NEVER commit .env (see .gitignore).
#
# Gmail delivery requires an App Password, NOT your login password:
# Google Account -> Security -> 2-Step Verification ON -> App passwords -> Mail.
# Paste the 16-character app password with no spaces or quotes. The app strips
# accidental whitespace/quotes, but a revoked/wrong/login password will fail.

# --- Email (SMTP) ---
# Only these two pairings are valid for Gmail-style servers:
#   STARTTLS:      EMAIL_PORT=587  +  EMAIL_USE_TLS=true   + EMAIL_USE_SSL=false
#   implicit SSL:  EMAIL_PORT=465  +  EMAIL_USE_TLS=false  + EMAIL_USE_SSL=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=sabhhagachhi@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL="Sabha Gachhi <sabhhagachhi@gmail.com>"
SERVER_EMAIL="Sabha Gachhi <sabhhagachhi@gmail.com>"

EMAIL_TIMEOUT=10
