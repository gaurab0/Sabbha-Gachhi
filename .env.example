# Copy to .env. Use long random alphanumeric values for credentials so they
# can be used safely in the MongoDB URI without URL escaping.

# Django settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173
TRUSTED_PROXY_COUNT=0
TZ=UTC

# MongoDB credentials. The app user is restricted to MONGO_DATABASE.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-32-character-alphanumeric-value
MONGO_APP_USERNAME=sabha_app
MONGO_APP_PASSWORD=replace-with-32-character-alphanumeric-value
MONGO_DATABASE=sabha_gachhi
MONGODB_DATABASE=sabha_gachhi

# Redis. DB 0 is Celery broker, DB 1 is Celery results, DB 2 is reserved for cache.
REDIS_PASSWORD=replace-with-32-character-alphanumeric-value
CELERY_BROKER_URL=redis://:replace-with-32-character-alphanumeric-value@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-32-character-alphanumeric-value@redis:6379/1
DJANGO_CACHE_URL=redis://:replace-with-32-character-alphanumeric-value@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Frontend build/runtime configuration. Production VITE_* values are baked
# into the frontend image and need a rebuild to change.
VITE_API_BASE_URL=/api
BACKEND_UPSTREAM=backend:8000

# Published host ports (dev binds to 127.0.0.1; prod exposes only frontend).
FRONTEND_DEV_PORT=5173
API_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379
FRONTEND_PORT=80
IMAGE_TAG=local
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=viewer:replace-with-a-random-password

# Existing application mail and SMS settings; leave blank to use development
# console delivery. Set real values in a production .env file.
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sabha Gachhi <noreply@example.invalid>
SERVER_EMAIL=Sabha Gachhi <noreply@example.invalid>
EMAIL_TIMEOUT=10
EMAIL_VERIFICATION_METHOD=link
EMAIL_LINK_EXPIRY_MINUTES=60
EMAIL_OTP_EXPIRY_MINUTES=10
PHONE_VERIFICATION_MODE=console
# Phase-2 master switch. false = email-only app (no phone step, no 403).
PHONE_VERIFICATION_REQUIRED=false
PHONE_SMS_ROUTES_JSON={}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=
DLT_SENDER_ID=
